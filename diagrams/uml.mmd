classDiagram
    class Owner {
        +String name
        +List~String~ preferences
        +List~Pet~ pets
        +add_pet(name: String, species: String) Pet
        +remove_pet(pet: Pet) void
    }

    class Pet {
        +String name
        +String species
        +List~String~ needs
        +retrieve_needs() List~String~
        +add_needs(need: String) void
        +remove_need(need: String) void
    }

    class Task {
        +String title
        +int duration
        +time start_time
        +int priority
        +update_priority(priority: int) void
        +add_tasks() void
        +remove_task() void
    }

    class Scheduler {
        +List~Task~ daily_tasks
        +List~time~ available_times
        +generate_schedule() List~Task~
        +prioritize_tasks() List~Task~
        +reschedule_task(task: Task, new_time: time) void
    }

    Owner "1" o-- "0..*" Pet : owns
    Pet "1" --> "0..*" Task : needs care via
    Scheduler "1" o-- "0..*" Task : schedules
    Scheduler ..> Owner : uses preferences of
